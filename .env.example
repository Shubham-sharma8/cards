# Copy to .env.local (web) or shell environment before running scripts/builds.
# NEVER commit populated credentials.

# Cloudflare R2 S3 Upload Credentials (for data/scripts/upload_to_r2.py)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Public Cloudflare R2 Delivery URL (e.g. https://pub-xxxxxxxxxxxxxxxx.r2.dev or https://cdn.example.com)
NEXT_PUBLIC_R2_PUBLIC_URL=
EXPO_PUBLIC_R2_PUBLIC_URL=

# Google Places API key (build-time script data/scripts/enrich_lounges_and_golf.py only)
GOOGLE_MAPS_MASTER_KEY=
