# ==============================================================================
# Cards by cogify (card.cogify.me) — Cloudflare Worker & Pages Environment Setup
# ==============================================================================
# Copy these variables into:
#   Cloudflare Dashboard -> Workers & Pages -> cards-cogify -> Settings -> Variables and Secrets
# OR save a private `web/.dev.vars` locally for `npm run preview:cf` (gitignored).

# --- Public Runtime & Build Variables (Plaintext) ---
NEXT_PUBLIC_SITE_URL=https://card.cogify.me
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-8a560aaca6404206b9adcd66799b1cee.r2.dev

# --- Cloudflare R2 Media & JSON Dossier Sync Secrets (Only needed for CI / media sync scripts) ---
# Add these as Encrypted Secrets if running R2 sync workflows from CI/CD:
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET_NAME=cardledger-media
R2_ACCESS_KEY_ID=your_r2_s3_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_s3_secret_access_key

# --- Optional: Cloudflare Workers CI Deployment Token ---
# Generate at: https://dash.cloudflare.com/profile/api-tokens (Edit Cloudflare Workers template)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
