    "get_this_card_if": [
      "You are looking for a card to save on your frequent domestic travels",
      "You want an agnostic travel card that does not come with any partner brand, airline or hotel restrictions",
      "You can maximise your reward points earnings and savings by availing the spend-based milestone benefits through your usual spending patterns"
    ],
    "faqs": [
      {
        "q": "Is there any expiration date for the reward points accrued through SBI Card Miles?",
        "a": "Yes, the earned reward points (Travel Credits) are only valid for 24 months from the date of their accrual."
      },
      {
        "q": "When will I get my earned Travel Credits using SBI Miles Credit Card?",
        "a": "Regular Travel Credits will reflect in your account within 10 days of the spend date and those earned as welcome bonus will reflect within 15 working days from the date of reaching the spending milestone."
      },
      {
        "q": "Is there any capping on reward earnings and redemptions on Miles SBI Card?",
        "a": "No, there is no capping on reward earnings or redemptions. However, the cardholders must use at least 2,000 Travel Credits for every redemption and must redeem their Travel Credits in the multiples of 2,000."
      },
      {
        "q": "Is there any free access to international lounges using SBI Miles Card?",
        "a": "Despite offering a complimentary Priority Pass to the cardholders, SBI Card Miles does not offer any free international lounge visit. Cardholders can access the lounges under this program without paying membership fee, but will have to pay the visit charges nonetheless."
      }
    ]
  },
