    "movie_benefits": [
      "5% cashback on spends at partner merchants-Swiggy, Swiggy Instamart, PVR, Cleartrip and Urban Company 1",
      "2 complimentary PVR tickets every quarter4",
      "Benefit on PVR movie tickets is spend-based"
    ],
