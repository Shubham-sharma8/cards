    "insurance_cover": [],
    "concierge_or_privilege": [],
    "get_this_card_if": [
      "You frequently shop at Myntra and can make the most of direct discount",
      "You often shop with other partner merchants like Swiggy, PVR, Cleartrip and more",
      "You can easily spend Rs. 50,000 in a quarter to avail free PVR tickets",
      "You wish to get a Rupay credit card in order to earn cashback on UPI transactions"
    ],
    "faqs": [
      {
        "q": "What is Myntra Insider Program?",
        "a": "Myntra Kotak Credit Card gives you complimentary Myntra Insider membership at the time of joining. Myntra Insider is a loyalty program that is available only to registered users on Myntra. With this membership, you can avail exclusive benefits like free shipping, early access to sales, exclusive offers and much more."
      },
      {
        "q": "How will I receive the Myntra e-gift voucher via my Myntra Kotak Credit Card?",
        "a": "The credit card rewards you with an e-voucher worth Rs. 500 on completing the first transaction worth Rs. 500 or more within 30 days of card issuance. You will receive the e-gift voucher on your registered email id and mobile number within 30 days of the transaction date."
      },
      {
        "q": "Can I avail of cashback on all transactions through my Myntra Kotak Credit Card?",
        "a": "You cannot avail of cashback on rent payments, fuel spends, EMI transactions, post-purchase EMI, wallet-loading transactions and cash advances."
      },
      {
        "q": "How will I avail of the instant discount on my transactions via Myntra Kotak Credit Card?",
        "a": "You can avail of the instant discount of 7.5% on your transactions at Myntra. The discount will be automatically applied at the time of checkout. You do not need to apply a coupon to avail the benefits. All you need to do is make the payment through Myntra Kotak Credit Card."
      },
      {
        "q": "Does Myntra Kotak Credit Card offer a fuel surcharge waiver?",
        "a": "Yes, you can avail of a fuel surcharge waiver of 1% on your transactions between Rs. 300 to Rs. 3,000 across all the petrol pumps. However, you can earn a maximum waiver of Rs. 3,500 in an anniversary year."
      },
      {
        "q": "Can I use my Myntra Kotak Credit Card for overseas transactions?",
        "a": "Yes, you can use your Kotak Myntra Credit Card for overseas transactions. However, a forex markup fee of 3.5% of the transacted amount will be charged by the bank for overseas transactions. Therefore, it is advisable to opt for a card that comes with a low forex markup fee for foreign currency transactions."
      }
    ]
  },
