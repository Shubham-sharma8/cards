  "benefits_features_and_faqs": {
    "about_overview": "MakeMyTrip ICICI Bank Credit Card is a replacement for the earlier MMT ICICI credit cards. While this card works on a similar structure, offering myCash on every spend, redeemable for travel bookings on MakeMyTrip, it offers higher as compared to its previous variants. At a moderate annual fee of Rs. 999, the card offers 6% myCash on hotel bookings, 3% on flights, holiday packages, cabs, and bus bookings made through MMT, and 1% on other spends done on or outside MMT.",
    "highlights": [
      "Unlimited 6% myCash (12 myCash per Rs. 200) on hotel bookings via MakeMyTrip",
      "Unlimited 3% myCash (6 myCash per Rs. 200) on flights, holiday packages, cabs & bus bookings via MakeMyTrip",
      "1% myCash (2 myCash per Rs. 200) on all other spends, including domestic & international spends outside MakeMyTrip1,2",
      "25 myCash on every train booking via MakeMyTrip"
    ],
    "welcome_benefit": null,
    "milestone_benefits": [
      "1% myCash (2 myCash per Rs. 200) on all other spends, including domestic & international spends outside MakeMyTrip1,2",
      "MMT voucher worth Rs. 1,000 valid for the first year",
      "MMT voucher worth Rs. 1,000 valid for three months, on the payment of annual fee",
      "Annual fee waiver on annual spends of Rs. 2.99 Lakh"
    ],
    "dining_benefits": [],
    "movie_benefits": [],
    "golf_benefits": [],
    "golf_summary": null,
    "insurance_cover": [],
    "concierge_or_privilege": [],
    "get_this_card_if": [
      "You do not mind sticking to MakeMyTrip for your travel bookings",
      "You’re looking for a credit card with a low forex markup fee",
      "You can easily spend Rs. 2 Lakh annually to qualify for a tier upgrade",
      "You are fine with redeeming reward points exclusively on MakeMyTrip"
    ],
    "faqs": [
      {
        "q": "Can I earn rewards on insurance payments with MakeMyTrip ICICI Bank Credit Card?",
        "a": "Yes, you can earn 1% myCash on insurance payments made through MakeMyTrip ICICI Credit Card. However, there is a maximum capping of 1,000 myCash per year on insurance spends."
      },
      {
        "q": "Does MakeMyTrip ICICI Bank Credit Card offer lounge access?",
        "a": "Yes, this credit card offers 8 complimentary domestic lounge visits per year (maximum 2 per quarter). Besides this, you can also avail 1 complimentary international lounge visit per year."
      },
      {
        "q": "How can I redeem myCash earned via MakeMyTrip ICICI Bank Credit Card?",
        "a": "You can redeem myCash against travel bookings on MakeMyTrip at a value of 1 myCash = Rs. 1. While making a payment, select ‘myCash’ as the payment option to use your accumulated myCash for MMT bookings."
      },
      {
        "q": "Can I use MakeMyTrip ICICI Bank Credit Card for international transactions?",
        "a": "Yes, but you need to activate the card for international transactions. You can do this via the iMobile Pay app or by logging into ICICI Bank internet banking. The card also charges a low forex markup fee of 0.99%, making it a suitable option for international spends."
      },
      {
        "q": "How can I redeem the voucher received as a welcome & annual benefit on MakeMyTrip ICICI Bank Credit Card?",
        "a": "You can redeem the voucher at the checkout page while making a booking. Select ‘myCash & MMT Voucher’, then click on ‘Use & Apply’ to redeem the voucher."
      },
      {
        "q": "Will I receive two credit cards when I apply for MakeMyTrip ICICI Bank Credit Card?",
        "a": "Yes, MakeMyTrip ICICI Bank Credit Card is issued as a dual-network proposition with Mastercard and RuPay. Cardholders will receive both variants upon onboarding, offering better network flexibility."
      },
      {
        "q": "Does MakeMyTrip ICICI Bank Credit Card offer benefits on train bookings?",
        "a": "Yes, you can earn 25 myCash for every train booking made through MakeMyTrip using this credit card."
      }
    ]
  },
